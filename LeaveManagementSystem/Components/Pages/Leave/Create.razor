@page "/leave/create"
@inject ILeaveService service
@inject NavigationManager Navigation

<h3 class="text-center mb-4">New Leave Request</h3>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <EditForm Model="leave" OnValidSubmit="AddLeave">
                        <DataAnnotationsValidator />
                        <LeaveForm Data="leave" />

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/leave" class="btn btn-secondary">Cancel</a>
                            <button class="btn btn-primary" type="submit">Add Leave</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Leave leave = new Leave();

    private void AddLeave()
    {
        service.Add(leave);
        Navigation.NavigateTo("/leave");
    }

}

@page "/leave"
@inject ILeaveService leaveService

<h3 class="text-center">Leave Requests</h3>
<a href="/leave/create" class="btn btn-primary">Add Leave</a>

<table class="table">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Type of Leave</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in leaves)
        {
            <LeaveCard LeaveData="item" OnDelete="HandleDelete"/>
        }
    </tbody>
</table>

@if (showDeleteModal)
{
    <div class="modal fade show d-block">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Leave</h5>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this leave request?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteLeave">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Leave> leaves = new List<Leave>();
    private Leave? selectedLeave;
    private bool showDeleteModal = false;

    protected override void OnInitialized()
    {
        leaves = leaveService.GetLeaveList();
    }

    private void HandleDelete(Leave leave)
    {
        selectedLeave = leave;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showDeleteModal = false;
    }

    private void DeleteLeave()
    {
        if (selectedLeave == null)
        {
            return;
        }
        leaveService.Delete(selectedLeave);
        CloseModal();
    }

}

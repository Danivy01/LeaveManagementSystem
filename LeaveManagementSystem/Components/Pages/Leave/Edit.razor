@page "/leave/edit/{Id:int}"

@inject ILeaveService service
@inject NavigationManager Navigation

<h3 class="text-center mb-4">Update Leave Request</h3>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    @if (leave != null)
                    {
                        <EditForm Model="leave" OnValidSubmit="Update">
                        <DataAnnotationsValidator/>
                        <LeaveForm Data="leave"/>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a href="/leave" class="btn btn-secondary">Cancel</a>
                            <button class="btn btn-primary">Save Changes</button>
                        </div>
                        </EditForm>
                    } else
                    {
                        <div class="text-center">
                            <h4>Leave Request not found</h4>
                            <p class="text-muted">
                                The leave request you are trying to edit does not exist.
                            </p>
                            <a href="/leave" class="btn btn-primary">Back to Leave List</a>
                        </div>
                        
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Leave leave = new Leave();
    [Parameter] public int Id { get; set; }


    protected override void OnParametersSet()
    {
        leave = service.GetID(Id);
    }

    private void Update()
    {
        service.Edit(leave);
        Navigation.NavigateTo("/leave");
    }
}
